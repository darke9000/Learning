    header {
      text-align: center;
      background: linear-gradient(135deg, #111, #2b0000);
      padding-bottom: 30px;
      border-bottom: 3px solid #e63946;
    }

    #header-img {
      width: 100%;
      max-height: 300px;
      object-fit: cover;
      display: block;
      margin-bottom: 20px;
    }

    header h1 {
      font-size: 3rem;
      color: #e63946;
      text-transform: uppercase;
      letter-spacing: 4px;
      margin-bottom: 20px;
    }

    nav {
      display: flex;
      justify-content: center;
      gap: 30px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      font-size: 1.1rem;
      padding: 10px 20px;
      border: 1px solid #e63946;
      border-radius: 5px;
      transition: 0.3s;
    }

    nav a:hover {
      background: #e63946;
      color: #111;
    }

    main {
      max-width: 1000px;
      margin: auto;
      padding: 40px 20px;
    }

    section {
      margin-bottom: 50px;
    }

    h2 {
      text-align: center;
      font-size: 2rem;
      color: #e63946;
      margin-bottom: 30px;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    #menu {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    #menu > h2 {
      grid-column: 1 / -1;
    }

    article {
      background: #1c1c1c;
      border: 1px solid #333;
      border-radius: 10px;
      overflow: hidden;
      text-align: center;
      padding-bottom: 20px;
      transition: transform 0.3s, border-color 0.3s;
    }

    article:hover {
      transform: translateY(-5px);
      border-color: #e63946;
    }

    article img {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }

    article h3 {
      color: #fff;
      font-size: 1.4rem;
      margin: 15px 0 10px;
    }

    article p {
      padding: 0 15px;
      color: #ccc;
    }

    article i {
      color: #e63946;
      font-weight: bold;
