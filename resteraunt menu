      margin-right: 20px;
      font-weight: normal;
    }

    input[type="radio"],
    input[type="checkbox"] {
      margin-right: 6px;
    }

    input[type="submit"] {
      width: 100%;
      padding: 15px;
      background: #e63946;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 1.1rem;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    input[type="submit"]:hover {
      background: #ff5964;
    }

    footer {
      text-align: center;
      background: #080808;
      padding: 25px;
      border-top: 2px solid #e63946;
